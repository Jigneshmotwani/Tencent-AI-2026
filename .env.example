# Native startup auto-generates local-only secrets into ignored .env.
# Loopback ports. Change these if another local project already uses them; the launcher derives
# DATABASE_URL, APP_ORIGIN, API_ORIGIN, LITELLM_URL and OTEL_ENDPOINT from them.
LOCAL_PORT_APP=5173
LOCAL_PORT_API=8000
LOCAL_PORT_GATEWAY=4000
LOCAL_PORT_COLLECTOR=4318
LOCAL_PORT_DB=55432
DATABASE_URL=postgresql+psycopg://app@127.0.0.1:55432/app
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8000
ENCRYPTION_KEY=
LITELLM_MASTER_KEY=
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_FOLDER_ID=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_CLOUD_ID=
# Required real inference entitlement. Use a verified LiteLLM provider/model string.
MODEL_ID=
MODEL_API_KEY=
MODEL_API_BASE=
MODEL_ALIAS=knowledge-model
# Optional JSON of provider-specific request fields, e.g. {"reasoning_effort":"none"} (ai& deepseek models: none|high|max).
MODEL_EXTRA_BODY=
# Optional USD per 1M tokens, only from your provider's published pricing (else cost stays unknown).
MODEL_INPUT_PER_1M=
MODEL_OUTPUT_PER_1M=
LITELLM_URL=http://127.0.0.1:4000
OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Optional bootstrap passwords; otherwise generated into .local/demo-accounts.txt.
BOOTSTRAP_OPERATIONS_PASSWORD=
BOOTSTRAP_COMPLIANCE_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_AUDITOR_PASSWORD=
# Optional bounded runtime configuration (server enforces maximum values).
SOURCE_TIMEOUT=25
MAX_EVIDENCE=8
MAX_CONTENT_BYTES=2000000
MAX_EXCERPT_CHARS=6000
MAX_OUTPUT_TOKENS=1200
MAX_ACTIVE_RUNS=4
