# ROSS configuration template. Copy to .env (git-ignored) and fill in the blanks; every value here is a placeholder.
# The launcher (./scripts/start.sh) reads this file, then .env, and writes generated local secrets into .env.

# ---- Loopback ports (the launcher derives DATABASE_URL, APP_ORIGIN, API_ORIGIN, LITELLM_URL and OTEL_ENDPOINT from them)
# Web UI (Vite dev server).
LOCAL_PORT_APP=5273
# FastAPI backend; the Google and Atlassian OAuth redirect URIs use this port.
LOCAL_PORT_API=8100
# Local LiteLLM gateway.
LOCAL_PORT_GATEWAY=4100
# OTel Collector (OTLP/HTTP).
LOCAL_PORT_COLLECTOR=4418
# PostgreSQL.
LOCAL_PORT_DB=55433
# HTTPS OAuth callback shim (Slack only accepts HTTPS redirects); the Slack redirect URI uses this port.
LOCAL_PORT_API_TLS=8543
# Grafana, Tempo and Prometheus (compose observability stack).
LOCAL_PORT_GRAFANA=3100
LOCAL_PORT_TEMPO=3300
LOCAL_PORT_PROMETHEUS=9190

# ---- App
# Owner database URL; the launcher rewrites it with the generated password and LOCAL_PORT_DB.
DATABASE_URL=postgresql+psycopg://app@127.0.0.1:55433/app
# Runtime (least-privilege) database URL; derived by the launcher.
APP_DATABASE_URL=
# Product name shown in the UI.
APP_NAME=ROSS
# Browser origin of the UI; derived from LOCAL_PORT_APP.
APP_ORIGIN=http://localhost:5273
# Origin of the API; derived from LOCAL_PORT_API.
API_ORIGIN=http://localhost:8100
# Origin of the HTTPS callback shim; derived from LOCAL_PORT_API_TLS.
API_TLS_ORIGIN=https://localhost:8543
# Grafana URL linked from the UI; derived from LOCAL_PORT_GRAFANA.
GRAFANA_URL=http://localhost:3100
# Fernet key that encrypts stored OAuth tokens; generated when empty.
ENCRYPTION_KEY=
# Set true only when served over HTTPS.
COOKIE_SECURE=false
# Session lifetime in hours (1-24).
SESSION_HOURS=12
# Local demo user switcher (loopback only, audited). Never enable outside a local demo.
DEMO_MODE=false

# ---- Generated secrets (the launcher fills these when empty)
# Password of the local Postgres owner role.
LOCAL_DB_PASSWORD=
# Password of the runtime DB role the API uses.
APP_RUNTIME_DB_PASSWORD=
# Password of Grafana's read-only DB role.
GRAFANA_DB_PASSWORD=
# Grafana admin password.
GRAFANA_ADMIN_PASSWORD=
# HMAC key for the hash-chained audit trail.
AUDIT_HMAC_KEY=
# LiteLLM gateway master key.
LITELLM_MASTER_KEY=

# ---- Google Drive (OAuth web client; redirect http://localhost:<LOCAL_PORT_API>/api/connections/drive/callback)
# OAuth client id.
GOOGLE_CLIENT_ID=
# OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Fallback Drive folder id (or comma-separated ids) when no demo pack is loaded.
GOOGLE_FOLDER_ID=
GOOGLE_FOLDER_IDS=

# ---- Atlassian: one OAuth 2.0 (3LO) app for Confluence and Jira
# OAuth client id.
ATLASSIAN_CLIENT_ID=
# OAuth client secret.
ATLASSIAN_CLIENT_SECRET=
# Cloud id of your Atlassian site.
CONFLUENCE_CLOUD_ID=
# Fallback Confluence space key (or comma-separated keys) when no demo pack is loaded.
CONFLUENCE_SPACE_KEY=
CONFLUENCE_SPACE_KEYS=
# Fallback comma-separated Jira project keys when no demo pack is loaded.
JIRA_PROJECT_KEYS=KYB,FINCRIME

# ---- Slack: per-user OAuth with user tokens (redirect https://localhost:<LOCAL_PORT_API_TLS>/api/connections/slack/callback)
# Slack app client id.
SLACK_CLIENT_ID=
# Slack app client secret.
SLACK_CLIENT_SECRET=
# Workspace id (T...); tokens for any other workspace are refused.
SLACK_TEAM_ID=
# Fallback channels ROSS reads, when no demo pack is loaded.
SLACK_CHANNELS=kyb-ops,compliance-escalations
# Fallback channels approved posts may go to.
SLACK_WRITE_CHANNELS=kyb-ops,compliance-escalations

# ---- Model (behind the local LiteLLM gateway)
# LiteLLM provider/model string, e.g. openai/<provider model id>.
MODEL_ID=
# Provider API key.
MODEL_API_KEY=
# Provider base URL (OpenAI-compatible endpoints).
MODEL_API_BASE=
# Alias the app uses for the default model.
MODEL_ALIAS=knowledge-model
# Optional JSON of provider-specific request fields, e.g. {"reasoning_effort":"none"}.
MODEL_EXTRA_BODY=
# Optional USD per 1M input tokens, from your provider's published pricing (else cost stays unknown).
MODEL_INPUT_PER_1M=
# Optional USD per 1M output tokens.
MODEL_OUTPUT_PER_1M=
# Optional JSON list of extra model aliases selectable in Studio. Each: {"alias", "model", "api_key_env", "api_base",
# "extra_body", "label", "input_per_1m", "output_per_1m"}.
EXTRA_MODELS=
# Optional cheaper model alias for the chat intent guardrail (empty = MODEL_ALIAS).
GUARDRAIL_MODEL_ALIAS=
# Seconds allowed for the intent guardrail check (1-15).
GUARDRAIL_CHECK_TIMEOUT=8
# Gateway URL; derived from LOCAL_PORT_GATEWAY.
LITELLM_URL=http://127.0.0.1:4100
# OTLP traces endpoint; derived from LOCAL_PORT_COLLECTOR.
OTEL_ENDPOINT=http://127.0.0.1:4418/v1/traces

# ---- Bootstrap accounts (optional; otherwise passwords are generated into .local/demo-accounts.txt)
BOOTSTRAP_OPERATIONS_PASSWORD=
BOOTSTRAP_COMPLIANCE_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_AUDITOR_PASSWORD=

# ---- Runtime bounds (the server enforces the maximums)
# Seconds per source call (1-60).
SOURCE_TIMEOUT=25
# Documents per answer (2-8).
MAX_EVIDENCE=8
# Bytes read per document.
MAX_CONTENT_BYTES=2000000
# Characters kept per document excerpt.
MAX_EXCERPT_CHARS=6000
# Answer token cap.
MAX_OUTPUT_TOKENS=1200
# Concurrent chat runs per user (1-4).
MAX_ACTIVE_RUNS=4
# Steps per agent run.
WORKFLOW_MAX_STEPS=40
# Tokens per agent run.
WORKFLOW_MAX_TOKENS=60000
# Concurrent agent runs.
WORKFLOW_MAX_ACTIVE=4
# Directory that stdio MCP server commands must run from.
MCP_STDIO_DIR=mcp_servers
# Trigger polling in seconds (Jira new issue, Drive new file, schedules); 0 disables, minimum 15.
TRIGGER_POLL_S=30

# ---- Read from the process environment only
# Optional path to local PostgreSQL binaries when not using --services compose.
# PG_BIN=

# ---- Separate git-ignored files used by the demo seeder (not read from .env)
# .local/demo-identities.env: ROSS_A_EMAIL, ROSS_B_EMAIL, ROSS_A_SLACK_EMAIL, ROSS_B_SLACK_EMAIL (real demo account emails).
# .local/atlassian-setup.env: ATLASSIAN_EMAIL, ATLASSIAN_API_TOKEN (owner account; seeding only).
