  {
   "id": 1,
   "type": "stat",
   "title": "Audit chain length (max seq)",
   "description": "Every audit row is HMAC-chained; Verify integrity in the app walks this chain.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "appdb"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "appdb"
     },
     "rawSql": "SELECT COALESCE(MAX(seq),0) AS \"events\" FROM v_audit",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 2,
