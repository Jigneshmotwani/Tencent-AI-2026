    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "appdb"
     },
     "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), COALESCE(SUM(cost_usd),0) AS cost FROM v_usage WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code"
