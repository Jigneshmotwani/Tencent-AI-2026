  {
   "id": 7,
   "type": "timeseries",
   "title": "Tokens by kind · model (live OTel counter, cumulative since API start)",
   "description": "Cumulative counters (not rate): sparse demo traffic would otherwise hide the first call of each series. Resets when the API restarts; Postgres panels are the durable record.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (kind, model) (ai_tokens_total)",
     "legendFormat": "{{kind}} · {{model}}",
     "range": true,
     "instant": false
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true,
      "showPoints": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "timeFrom": "6h"
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Model latency p50 / p95 (gateway calls)",
   "description": "Quantiles over all model calls since API start (ai_model_latency histogram, recorded by the gateway for every call).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (ai_model_latency_milliseconds_bucket))",
     "legendFormat": "p50",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (ai_model_latency_milliseconds_bucket))",
     "legendFormat": "p95",
     "range": true,
     "instant": false
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true,
      "showPoints": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "timeFrom": "6h"
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Cost per hour (recorded)",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
