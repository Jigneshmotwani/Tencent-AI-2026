  {
   "id": 4,
   "type": "stat",
   "title": "Run latency p50",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "appdb"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "appdb"
     },
     "rawSql": "SELECT COALESCE(percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms),0) AS \"p50\" FROM v_usage WHERE $__timeFilter(created_at) AND latency_ms IS NOT NULL",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
