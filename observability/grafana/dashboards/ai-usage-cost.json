 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Cost (USD, recorded)",
   "description": "Sum of recorded per-run cost (chat runs.usage.cost + workflow_runs.cost_usd) from Postgres view v_usage.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "appdb"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "appdb"
     },
     "rawSql": "SELECT COALESCE(SUM(cost_usd),0) AS \"cost\" FROM v_usage WHERE $__timeFilter(created_at)",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 2,
