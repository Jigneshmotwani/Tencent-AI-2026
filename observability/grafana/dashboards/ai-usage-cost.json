    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "appdb"
     },
     "rawSql": "SELECT username AS \"user\", COUNT(*) AS runs, COALESCE(SUM(total_tokens),0) AS tokens, COALESCE(SUM(cost_usd),0) AS cost_usd FROM v_usage WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY cost_usd DESC",
     "format": "table",
     "rawQuery": true,
