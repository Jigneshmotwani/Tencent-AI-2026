{
 "uid": "ai-usage-cost",
 "title": "AI Usage & Cost",
 "description": "Tokens, cost and latency by user, workflow and model. Postgres v_usage (durable) + Prometheus OTel metrics (live).",
 "tags": [
  "ai",
  "cost"
 ],
 "timezone": "browser",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "links": [
  {
   "title": "AI Usage & Cost",
   "type": "link",
   "url": "/d/ai-usage-cost"
