  {
   "id": 6,
   "type": "stat",
   "title": "Model calls (live, since API start)",
   "description": "Cumulative OTel counter ai_model_requests from the running API process(es); resets when the API restarts.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(ai_model_requests_total)",
     "legendFormat": "",
     "range": false,
     "instant": true
    }
   ],
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
